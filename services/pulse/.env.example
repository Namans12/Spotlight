# Release Pulse service: local configuration template.
#
#   cp services/pulse/.env.example services/pulse/.env     (then fill in the values)
#   npm --prefix services/pulse run start:local
#
# services/pulse/.env is gitignored. NEVER commit it, and never paste these values
# into chat, an issue, a README or a browser app (Qloo's kit forbids it).

# --- Required ---------------------------------------------------------------
# Postgres for the Pulse tables + Spotlight's release data. For local work use a
# throwaway database; for the hackathon deployment use its own Neon database.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/spotlight_test

# Qloo hackathon key (the hackathon host is the default; do not point it at
# api.qloo.com or staging, the hackathon key fails there).
QLOO_API_KEY=

# Groq key (campaign writer + chat). The free tier works (see the limits below).
GROQ_API_KEY=

# TMDB v3 API key (the short one, NOT the long "read access token").
# The service refuses to start without it unless QLOO_FIXTURES=1.
TMDB_API_KEY=

# --- Local development ------------------------------------------------------
PORT=8799
# Origins allowed to call the service from a browser (the Vite dev server).
PULSE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Secret for POST /warm (any long random string you make up).
PULSE_WARM_SECRET=

# --- Optional tuning --------------------------------------------------------
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low        # default "low" for openai/gpt-oss models; "off" or empty disables it
#
# Quotas are sized for Groq's FREE tier: 8,000 tokens a MINUTE and 1,000 requests
# a DAY. The units are drafts and chat turns, and one chat turn can make several
# of the 1,000 provider requests: at about 3 requests per chat, the global default
# of 300 can already come to roughly 900 requests a day, so do not raise it on the
# free tier. A campaign draft takes one request (up to 3 with retries).
# Raising these needs a paid Groq tier, or another OpenAI-compatible provider
# (point GROQ_BASE_URL and GROQ_MODEL at it).
# PULSE_SESSION_DAILY_CHAT=12
# PULSE_SESSION_DAILY_CAMPAIGN=20
# PULSE_GLOBAL_DAILY_LLM=300
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# --- Synthetic data (development only) --------------------------------------
# QLOO_FIXTURES=1 serves invented Qloo data and needs no Qloo key. The service
# refuses to run it with NODE_ENV=production unless PULSE_ALLOW_FIXTURES=1.
# Fixtures mode still needs TMDB_API_KEY to resolve titles that have no title_ratings row (otherwise the brief says Qloo could not be reached).
# QLOO_FIXTURES=1
